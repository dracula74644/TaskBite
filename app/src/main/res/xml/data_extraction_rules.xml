<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="taskbite.db" />
        <include domain="database" path="taskbite.db-wal" />
        <include domain="database" path="taskbite.db-shm" />
        <include domain="sharedpref" path="taskbite.xml" />
        <include domain="sharedpref" path="update_preferences.xml" />
        <include domain="file" path="voice_clips/" />
        <include domain="file" path="personal_voice_packs/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="taskbite.db" />
        <include domain="database" path="taskbite.db-wal" />
        <include domain="database" path="taskbite.db-shm" />
        <include domain="sharedpref" path="taskbite.xml" />
        <include domain="sharedpref" path="update_preferences.xml" />
        <include domain="file" path="voice_clips/" />
        <include domain="file" path="personal_voice_packs/" />
    </device-transfer>
</data-extraction-rules>
